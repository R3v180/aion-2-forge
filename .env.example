DATABASE_URL=postgresql://usuario:clave@host/neondb?sslmode=require&channel_binding=require
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
# local | produccion (en produccion la cookie de sesión solo viaja por HTTPS)
ENTORNO=local

# Solo para desplegar desde la CLI de Render
RENDER_API_KEY=

# Cloudflare Turnstile (anti-bots en registro). Sin esto se usa un reto de suma.
# https://dash.cloudflare.com/ → Turnstile → Add widget
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

